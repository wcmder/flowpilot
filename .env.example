OPENAI_API_KEY=your_api_key_here
FLOWPILOT_MODEL=gpt-5-mini
# responses, chat_completions, or auto
FLOWPILOT_LLM_API=responses
# Client-side LLM request throttle. Use 120 for providers limited to 120 requests/min.
FLOWPILOT_LLM_REQUESTS_PER_MINUTE=120
# Client-side timeout for one LLM request. Increase for slower models/gateways.
FLOWPILOT_LLM_TIMEOUT_SECONDS=120
# Optional: set this for an OpenAI-compatible gateway in a restricted network.
# FLOWPILOT_OPENAI_BASE_URL=https://your-openai-compatible-endpoint.example/v1
# Optional: set this when TShark is installed but not visible on PATH.
# Windows example:
# FLOWPILOT_TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
